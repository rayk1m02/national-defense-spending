{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPrestaged",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::national-defense-spending-dev-381492047455-us-east-1-an/prestaged/*"
    },
    {
      "Sid": "ListPrestaged",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::national-defense-spending-dev-381492047455-us-east-1-an",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["prestaged/*"]
        }
      }
    }
  ]
}