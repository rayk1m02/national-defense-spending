{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "WriteAndAbortObject",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:AbortMultipartUpload"
            ],
            "Resource": [
                "arn:aws:s3:::national-defense-spending-dev-381492047455-us-east-1-an/raw/*",
                "arn:aws:s3:::national-defense-spending-dev-381492047455-us-east-1-an/prestaged/*"
            ]
        },
        {
            "Sid": "ListRawPrefix",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::national-defense-spending-dev-381492047455-us-east-1-an"
            ],
            "Condition": {
                "StringLike": {
                    "s3:prefix": ["raw/*", "prestaged/*"]
                }
            }
        }
    ]
}